// EXEMPLO de regras do Firestore para a Luary — REVISE E TESTE no "Simulador de regras" do console
// antes de publicar. Troque SEU_EMAIL_ADMIN@exemplo.com pelo(s) e-mail(s) dos administradores.
//
// O que estas regras fazem:
//  - catálogo, banners, categorias, marketplaces e configurações: leitura pública, escrita só de admin;
//  - promoções: a LISTAGEM pública só devolve promoções automáticas ativas; cupons (documentos cp_CODIGO)
//    só podem ser lidos pelo ID exato, então a lista de códigos não fica exposta;
//  - pedidos: qualquer visitante pode CRIAR um pedido (com formato validado), mas só admin lê, edita ou exclui.
//
// Limite conhecido: as regras não conseguem conferir se os preços do pedido batem com o catálogo.
// Por isso o painel de pedidos mostra os valores gravados para conferência humana antes de cobrar.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['luarysemijoias@gmail.com'];
    }

    function validOrder(d) {
      return d.keys().hasOnly(['number','status','source','createdAtIso','createdAt','customer','delivery','payment','notes','items','totals'])
        && d.keys().hasAll(['number','status','customer','delivery','payment','items','totals','createdAt'])
        && d.number is string && d.number.size() >= 4 && d.number.size() <= 30
        && d.status == 'Novo'
        && d.createdAt == request.time
        && d.customer.name is string && d.customer.name.size() >= 2 && d.customer.name.size() <= 120
        && d.customer.whatsapp is string && d.customer.whatsapp.size() >= 10 && d.customer.whatsapp.size() <= 15
        && d.items is list && d.items.size() > 0 && d.items.size() <= 200
        && d.totals.total is number && d.totals.total >= 0 && d.totals.total <= 1000000
        && (!('notes' in d) || d.notes.size() <= 500);
    }

    match /products/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /subcategories/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /marketplaceGrids/{id} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{id}     { allow read: if true; allow write: if isAdmin(); }

    match /promotions/{id} {
      allow get: if true;
      allow list: if isAdmin() || (resource.data.kind == 'automatic' && resource.data.active == true);
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow create: if validOrder(request.resource.data) && id == request.resource.data.number;
      allow read, update, delete: if isAdmin();
    }

    match /adminLogs/{id} { allow read, create: if isAdmin(); }
  }
}
